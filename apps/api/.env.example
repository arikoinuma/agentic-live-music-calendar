# Copy to `.env` and adjust. `.env` is git-ignored; this file is not.
#
# pydantic-settings matches these names to the fields on `Settings` in
# app/config.py case-insensitively, so DATABASE_URL populates
# `database_url`. Every variable listed as REQUIRED below has no default
# — the app raises a ValidationError at import time if it's missing,
# which is deliberate: a missing config value should fail loudly at
# startup, not silently at the first request that needs it.

# ---------------------------------------------------------------------
# REQUIRED
# ---------------------------------------------------------------------

# Local Postgres from docker-compose.yml at the repo root.
#
# Two things about this URL that are easy to get wrong:
#
#   1. The `+asyncpg` suffix picks SQLAlchemy's async driver. Without
#      it, SQLAlchemy defaults to the sync psycopg driver and
#      create_async_engine() fails.
#
#   2. Do NOT append `?sslmode=require` or `?channel_binding=require`.
#      Those are libpq/psycopg parameter names; SQLAlchemy passes URL
#      query params straight through to asyncpg's connect(), which
#      doesn't recognize either one and raises a TypeError rather than
#      ignoring them. This bites specifically when copying a connection
#      string out of Neon's dashboard, which generates both by default.
#      See docs/dev/notes.md for the full write-up.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/calendar_dev

# The Ollama model tag the agent worker extracts with. `gemma4:e4b` is
# the outcome of the model evaluation in docs/dev/env-setup.md Phase 5 —
# not a default, an actual decision. Confirm it's pulled with
# `ollama list` before running the worker.
# gemma4:e4b alone runs at Ollama's 4096-token default window (its /v1 endpoint ignores a
# request's num_ctx), which truncates long pages. Use the derived model instead — see
# apps/api/ollama/gemma4-e4b-32k.Modelfile and docs/dev/notes.md.
MODEL_NAME=gemma4-e4b-32k

# Optional. A larger Ollama model for the third (last) retry attempt of a failed extraction
# (arch-initial.md §7; agent_worker/policy.py). Leave unset on a laptop that can't run one:
# attempt 3 then reruns MODEL_NAME with the full retry hint, and the attempt record says so.
# ESCALATION_MODEL_NAME=

# ---------------------------------------------------------------------
# TEST VARIABLES — shell / CI environment ONLY. Do NOT put these in .env.
# ---------------------------------------------------------------------
#
# TEST_DATABASE_URL  Overrides where the DB tests run. Default: DATABASE_URL
#                    with the database name swapped to `calendar_test`, and
#                    only if its host is local. The test fixtures DROP and
#                    recreate that database, so the name must be exactly
#                    `calendar_test`.
# REQUIRE_DB=1       Turn "Postgres isn't reachable" from a skip into a
#                    failure. `make test` / `make check` set it; so does CI.
#
# Why not in .env: `Settings` (app/config.py) forbids unknown keys, so an
# extra line here raises a ValidationError for the whole app, Alembic and
# every test — and pydantic-settings doesn't export .env values to
# os.environ anyway, so the test fixtures would never see them.
#   TEST_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/calendar_test pytest

# ---------------------------------------------------------------------
# NOT YET REQUIRED — listed so the shape is known before it's needed
# ---------------------------------------------------------------------

# MongoDB Atlas, for the agent worker's raw pre-validation staging
# documents (arch-initial.md Section 6). The cluster is already
# provisioned (env-setup.md Phase 7); nothing writes to it until the
# staging write lands in milestone A4 of docs/dev/alpha-build-plan.md.
# MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/?retryWrites=true&w=majority

# Cloudflare R2, for per-page snapshots from the Fetch step. Deferred —
# see alpha-build-plan.md section 8. audit_log.snapshot_key stays null
# until this exists.
# R2_ENDPOINT_URL=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=

# Shared secret for the Next.js -> FastAPI server-to-server call
# (arch-initial.md Section 5). Deferred: no FastAPI dependency checks
# it and no fetch call sends it yet, so setting it now would be an
# unused value.
# API_SHARED_SECRET=
