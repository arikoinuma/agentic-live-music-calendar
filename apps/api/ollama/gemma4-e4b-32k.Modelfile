# A derived Ollama model: the same weights as gemma4:e4b, with a 32768-token context
# window as its default. Why it exists: Ollama's OpenAI-compatible /v1 endpoint ignores
# a request's `options.num_ctx`, so the pipeline and eval were silently running at 4096
# tokens and long pages were cut off mid-answer (IncompleteOutputException). A model's
# own default is the one setting /v1 does honour. See docs/dev/notes.md and
# docs/dev/implementations/a2-extraction-schema.md (Decision #6).
#
# Create it once:   ollama create gemma4-e4b-32k -f apps/api/ollama/gemma4-e4b-32k.Modelfile
# Use it:           MODEL_NAME=gemma4-e4b-32k in apps/api/.env
# Remove it:        ollama rm gemma4-e4b-32k   (gemma4:e4b itself is untouched)
FROM gemma4:e4b
PARAMETER num_ctx 32768
