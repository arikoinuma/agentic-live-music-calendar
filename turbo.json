{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "tui",
  // Read by apps/calendar/playwright.config.ts (CI picks its reporter). Declared here so eslint-plugin-turbo
  // (which runs with --max-warnings 0) accepts the reads; passed through, not hashed,
  // because no cached task output depends on them.
  "globalPassThroughEnv": ["E2E_CHROMIUM_PATH", "CI"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**", "!.next/dev/**"],
      "env": ["API_BASE_URL", "NODE_ENV"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "check-types": {
      "dependsOn": ["^check-types"]
    },
    "test": {
      "dependsOn": ["^test"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
