{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "tui",
  // Read by apps/calendar/playwright.config.ts (CI picks its reporter; E2E_DATABASE_URL overrides the
  // end-to-end database's address, C2-D7). Declared here so eslint-plugin-turbo
  // (which runs with --max-warnings 0) accepts the reads; passed through, not hashed,
  // because no cached task output depends on them. APP_ENV (C3-D7, lib/app-env.ts) is the same kind: read per
  // request on the server, never baked into a build, so it must not change a build's cache key. So are C4's
  // SITE_ZONE, DEFAULT_METRO_SLUG and SITE_GATE_PASSWORD (lib/site-config.ts, read per request by the proxy). Left
  // undeclared, Vercel's build warns that they "WILL NOT be available" (Turborepo's strict env mode).
  "globalPassThroughEnv": [
    "E2E_CHROMIUM_PATH",
    "E2E_FROZEN_NOW",
    "E2E_DATABASE_URL",
    "APP_ENV",
    "SITE_ZONE",
    "DEFAULT_METRO_SLUG",
    "SITE_GATE_PASSWORD",
    "CI"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**", "!.next/dev/**"],
      "env": ["API_BASE_URL", "NODE_ENV"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "check-types": {
      "dependsOn": ["^check-types"]
    },
    "test": {
      "dependsOn": ["^test"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
